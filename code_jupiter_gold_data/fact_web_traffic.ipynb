import pandas as pd
import numpy as np

# Đọc dữ liệu từ file dim_date.csv đã được tạo trước đó
dim_date_df = pd.read_csv('/content/dim_date.csv')

# Lấy danh sách các date_key hiện có
date_keys = dim_date_df['date_key'].unique()

# Cấu hình sinh dữ liệu ngẫu nhiên có tính nhất quán
np.random.seed(42)

# Các nguồn traffic thông dụng
traffic_sources = ['Organic Search', 'Direct', 'Social Media', 'Paid Ads', 'Email Marketing', 'Referral']

fact_data = []
web_traffic_id_counter = 1

# Với mỗi date_key, chúng ta sẽ sinh ngẫu nhiên từ 3 đến 6 bản ghi cho các traffic_source khác nhau
for d_key in date_keys:
    num_sources = np.random.randint(3, 7) 
    chosen_sources = np.random.choice(traffic_sources, size=num_sources, replace=False)
    
    for source in chosen_sources:
        sessions = int(np.random.randint(100, 5000))
        # Unique visitors thường nhỏ hơn hoặc bằng sessions
        unique_visitors = int(sessions * np.random.uniform(0.6, 0.9))
        # Page views thường lớn hơn sessions
        page_views = int(sessions * np.random.uniform(1.5, 4.0))
        # Bounce rate nằm trong khoảng từ 0.2 đến 0.7
        bounce_rate = round(float(np.random.uniform(0.2, 0.7)), 4)
        # Average session duration tính bằng giây, ví dụ từ 30 giây đến 300 giây
        avg_session_duration = round(float(np.random.uniform(30.0, 300.0)), 2)
        
        fact_data.append({
            'web_traffic_id': web_traffic_id_counter,
            'date_key': d_key,
            'traffic_source': source,
            'sessions': sessions,
            'unique_visitors': unique_visitors,
            'page_views': page_views,
            'bounce_rate': bounce_rate,
            'avg_session_duration': avg_session_duration
        })
        web_traffic_id_counter += 1

# Tạo DataFrame
fact_web_traffic = pd.DataFrame(fact_data)

# Đảm bảo thứ tự các cột chính xác theo định nghĩa của bạn
schema_columns = [
    'web_traffic_id', 'date_key', 'traffic_source', 
    'sessions', 'unique_visitors', 'page_views', 
    'bounce_rate', 'avg_session_duration'
]
fact_web_traffic = fact_web_traffic[schema_columns]

# Lưu lại thành file csv
fact_web_traffic.to_csv('/content/fact_web_traffic.csv', index=False)

print(f"Đã tạo thành công file /content/fact_web_traffic.csv với {len(fact_web_traffic)} dòng dữ liệu!")
display(fact_web_traffic.head())